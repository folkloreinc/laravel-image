{
    "name": "laravel-image",
    "version": "1.1.0",
    "description": "Javascript helpers for the Laravel image manipulation package",
    "main": "js/lib/index.js",
    "module": "js/es/index.js",
    "files": [
        "js/lib",
        "js/es"
    ],
    "scripts": {
        "test": "jest",
        "lint": "eslint js/src && prettier --check js/src",
        "format": "prettier --write js/src",
        "clean": "rm -rf js/lib && rm -rf js/es",
        "build": "rollup --config --bundleConfigAsCjs",
        "prepare": "npm run clean && npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/folkloreinc/laravel-image.git"
    },
    "author": {
        "name": "Folklore",
        "email": "info@atelierfolklore.ca"
    },
    "contributors": [
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@atelierfolklore.ca"
        },
        {
            "name": "Nicolas Roy-Bourdages",
            "email": "nrb@atelierfolklore.ca"
        }
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/folkloreinc/laravel-image/issues"
    },
    "homepage": "https://github.com/folkloreinc/laravel-image#readme",
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "@eslint/js": "^10.0.0",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "babel-jest": "^30.0.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "globals": "^17.13.0",
        "jest": "^30.0.0",
        "prettier": "^3.0.0",
        "rollup": "^4.9.6"
    },
    "dependencies": {
        "lodash": "^4.17.4",
        "parse-filepath": "^1.0.2",
        "url-parse": "^1.2.0"
    },
    "jest": {
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/js/src"
        ],
        "collectCoverageFrom": [
            "js/src/**/*.js",
            "!js/src/**/__tests__/**"
        ]
    }
}
