includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    # 2.x has no baseline: fix an error instead of ignoring it.
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Files of 1.x projects, such as their routes/images.php
        - tests/fixtures
    tmpDir: build/phpstan
