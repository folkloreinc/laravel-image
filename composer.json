{
    "name": "folklore/laravel-image",
    "description": "On-the-fly image renditions for Laravel: presets, signed URLs and responsive variants, behind a CDN",
    "keywords": [
        "laravel",
        "image",
        "thumbnail",
        "resize",
        "crop",
        "presets",
        "responsive-images",
        "cdn"
    ],
    "homepage": "https://github.com/folkloreinc/laravel-image",
    "license": "MIT",
    "authors": [
        {
            "name": "Folklore",
            "email": "info@atelierfolklore.ca",
            "homepage": "http://atelierfolklore.ca"
        },
        {
            "name": "David Mongeau-Petitpas",
            "email": "dmp@atelierfolklore.ca",
            "homepage": "http://mongo.ca",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "intervention/image": "^4.3.4",
        "league/flysystem": "^3.25.1"
    },
    "require-dev": {
        "intervention/image-driver-vips": "^4.1",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "league/flysystem-aws-s3-v3": "^3.25.1",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "ext-exif": "Turns photos upright from their EXIF orientation",
        "ext-imagick": "Required by the imagick driver",
        "league/flysystem-aws-s3-v3": "Originals and derivatives on S3-compatible disks",
        "intervention/image-driver-vips": "The libvips driver, the fastest and the lightest on memory (needs libvips and ext-ffi with ffi.enable=true)",
        "folklore/laravel-mediatheque": "The media resolver (2.x), for the images and video posters of a media library"
    },
    "autoload": {
        "psr-4": {
            "Folklore\\Image\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Folklore\\Image\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/fixtures/"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover coverage/clover.xml --coverage-text",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-v2.x": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Folklore\\Image\\ImageServiceProvider"
            ]
        }
    }
}
